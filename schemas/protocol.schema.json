          "minimum": 1,
          "maximum": 2147483647,
          "default": 20971520
        },
        "maxFrameBytes": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 16777216,
          "default": 1048576
        },
        "maxQueuedFrames": {
          "type": "integer",
          "minimum": 8,
          "maximum": 4096,
          "default": 64
        },
        "maxQueuedFrameBytes": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 67108864,
          "default": 4194304
        },
        "maxConcurrentDownloads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1
        },
        "maxConcurrentPrints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1
        },
        "maxStagedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 536870912
        },
        "maxDownloadBytesPerSecond": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0,
