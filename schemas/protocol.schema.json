{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qrun.io/schemas/printing/v1/protocol.schema.json",
  "title": "QQQ Print Protocol v1",
  "description": "Select the DTO with #/$defs/Name.",
  "$defs": {
    "PrintingSessionIdentity": {
      "type": "object",
      "required": ["principalId", "tenantId"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "deviceId": { "$ref": "#/$defs/Id" }
      },
      "additionalProperties": true
    },
    "DeviceTestPrintRequest": {
      "type": "object",
      "required": [
        "printerId",
        "format",
        "requestId"
      ],
      "properties": {
        "printerId": {
          "$ref": "#/$defs/Id"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        },
        "testProfile": {
          "$ref": "#/$defs/TestPrintProfile"
        }
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "PDF"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "ZPL"
            },
            "testProfile": {
              "enum": [
                "LABEL_4X6_203",
                "LABEL_4X6_300",
                "LABEL_4X6_600"
              ]
            }
          }
        }
      ]
    },
    "TestPrintProfile": {
      "description": "Optional test-document media and label resolution. Omitted defaults: PDF LETTER, ZPL LABEL_4X6_203. This does not change a Windows queue's configured stock.",
      "enum": [
        "LETTER",
        "A4",
        "LABEL_4X6_203",
        "LABEL_4X6_300",
        "LABEL_4X6_600"
      ]
    },
    "DeviceRetryRequest": {
      "type": "object",
      "required": [
        "requestId"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/Id"
        },
        "confirmDuplicateRisk": {
          "type": "boolean"
        }
      }
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "Format": {
      "enum": [
        "PDF",
        "ZPL"
      ]
    },
    "PrinterStatus": {
      "enum": [
        "READY",
        "OFFLINE",
        "PAUSED",
        "ERROR",
        "UNKNOWN"
      ]
    },
    "JobStatus": {
      "enum": [
        "QUEUED",
        "CLAIMED",
        "RECEIVED",
        "SUBMITTING",
        "SPOOLED",
        "SPOOLER_COMPLETED",
        "FAILED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "CreateEnrollmentRequest": {
      "type": "object",
      "properties": {
        "facilityId": {
          "type": "string",
          "minLength": 1
        },
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "facilityId",
        "deviceName"
      ],
      "additionalProperties": true
    },
    "EnrollmentCode": {
      "type": "object",
      "properties": {
        "enrollmentCode": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "enrollmentCode",
        "expiresAt"
      ],
      "additionalProperties": true
    },
    "EnrollRequest": {
      "type": "object",
      "properties": {
        "enrollmentCode": {
          "type": "string",
          "minLength": 1
        },
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "agentVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enrollmentCode",
        "deviceName",
        "agentVersion"
      ],
      "additionalProperties": true
    },
    "EnrollResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "deviceId": {
          "$ref": "#/$defs/Id"
        },
        "deviceToken": {
          "type": "string",
          "minLength": 1
        },
        "pollIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [
        "protocolVersion",
        "deviceId",
        "deviceToken",
        "pollIntervalSeconds"
      ],
      "additionalProperties": true
    },
    "HeartbeatRequest": {
      "type": "object",
      "properties": {
        "agentVersion": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceProfile"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "agentVersion"
      ],
      "additionalProperties": true
    },
    "HeartbeatResponse": {
      "type": "object",
      "properties": {
        "serverTime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "serverTime"
      ],
      "additionalProperties": true
    },
    "Acknowledgment": {
      "type": "object",
      "properties": {
        "accepted": {
          "const": true
        }
      },
      "required": [
        "accepted"
      ],
      "additionalProperties": true
    },
    "Printer": {
      "type": "object",
      "properties": {
        "printerId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "driverName": {
          "type": "string",
          "maxLength": 1024
        },
        "portName": {
          "type": "string",
          "maxLength": 1024
        },
        "status": {
          "$ref": "#/$defs/PrinterStatus"
        },
        "formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Format"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "printerId",
        "name",
        "driverName",
        "portName",
        "status",
        "formats"
      ],
      "additionalProperties": true
    },
    "ManagedPrinter": {
      "type": "object",
      "properties": {
        "printerId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "driverName": {
          "type": "string",
          "maxLength": 1024
        },
        "portName": {
          "type": "string",
          "maxLength": 1024
        },
        "status": {
          "$ref": "#/$defs/PrinterStatus"
        },
        "formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Format"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "enabled": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean",
          "description": "Present in the latest locally selected printer exposure snapshot; independent of server approval."
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "printerId",
        "name",
        "driverName",
        "portName",
        "status",
        "formats",
        "enabled"
      ],
      "additionalProperties": true
    },
    "PrinterInventory": {
      "type": "object",
      "properties": {
        "printers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Printer"
          },
          "maxItems": 200
        }
      },
      "required": [
        "printers"
      ],
      "additionalProperties": true
    },
    "PrinterApproval": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": true
    },
    "PrintOptions": {
      "type": "object",
      "properties": {
        "copies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        },
        "scale": {
          "enum": [
            "ACTUAL_SIZE",
            "FIT"
          ],
          "default": "ACTUAL_SIZE"
        },
        "paperWidthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "paperHeightMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        }
      },
      "required": [],
      "additionalProperties": true,
      "dependentRequired": {
        "paperWidthMm": [
          "paperHeightMm"
        ],
        "paperHeightMm": [
          "paperWidthMm"
        ]
      }
    },
    "SubmitJobRequest": {
      "type": "object",
      "properties": {
        "deviceId": {
          "$ref": "#/$defs/Id"
        },
        "printerId": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "contentBase64": {
          "type": "string",
          "minLength": 1,
          "contentEncoding": "base64"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "options": {
          "$ref": "#/$defs/PrintOptions"
        }
      },
      "required": [
        "deviceId",
        "printerId",
        "title",
        "format",
        "contentBase64",
        "idempotencyKey"
      ],
      "additionalProperties": true
    },
    "PrintJob": {
      "type": "object",
      "properties": {
        "jobId": {
          "$ref": "#/$defs/Id"
        },
        "deviceId": {
          "$ref": "#/$defs/Id"
        },
        "printerId": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "options": {
          "$ref": "#/$defs/PrintOptions"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "message": {
          "type": "string"
        },
        "spoolerJobId": {
          "type": "string"
        }
      },
      "required": [
        "jobId",
        "printerId",
        "title",
        "format",
        "contentSha256",
        "contentLength",
        "options",
        "createdAt",
        "status"
      ],
      "additionalProperties": true
    },
    "ClaimResponse": {
      "type": "object",
      "properties": {
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrintJob"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job"
      ],
      "additionalProperties": true
    },
    "JobEvent": {
      "type": "object",
      "properties": {
        "eventId": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "enum": [
            "RECEIVED",
            "SUBMITTING",
            "SPOOLED",
            "SPOOLER_COMPLETED",
            "FAILED",
            "OUTCOME_UNKNOWN"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2048
        },
        "spoolerJobId": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "eventId",
        "status"
      ],
      "additionalProperties": true
    },
    "Device": {
      "type": "object",
      "properties": {
        "deviceId": {
          "$ref": "#/$defs/Id"
        },
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "facilityId": {
          "type": "string",
          "minLength": 1
        },
        "agentVersion": {
          "type": "string",
          "minLength": 1
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "computerName": {
          "type": "string",
          "maxLength": 1024
        },
        "profile": {
          "$ref": "#/$defs/DeviceProfile"
        },
        "control": {
          "$ref": "#/$defs/DeviceControlStatus"
        }
      },
      "required": [
        "deviceId",
        "deviceName",
        "facilityId",
        "agentVersion"
      ],
      "additionalProperties": true
    },
    "DeviceList": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Device"
          }
        }
      },
      "required": [
        "devices"
      ],
      "additionalProperties": true
    },
    "PrinterList": {
      "type": "object",
      "properties": {
        "printers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManagedPrinter"
          },
          "maxItems": 200
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 12000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "printers"
      ],
      "additionalProperties": true
    },
    "JobList": {
      "type": "object",
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrintJob"
          },
          "maxItems": 200
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "jobs"
      ],
      "additionalProperties": true
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    },
    "DeviceProfile": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "description": "Client-authoritative labels. Null or omitted preserves metadata; empty text clears the field. Empty name falls back to the technical computer name."
    },
    "ControlTimestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "Z$",
      "description": "RFC 3339 UTC timestamp, ending in uppercase Z."
    },
    "ControlCapability": {
      "enum": [
        "REFRESH_INVENTORY",
        "CANCEL_SPOOL"
      ]
    },
    "ProtocolVersionResponse": {
      "type": "object",
      "required": [
        "protocolVersion"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "DeviceDesiredState": {
      "type": "object",
      "required": [
        "revision",
        "dispatchPaused",
        "connectionState"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dispatchPaused": {
          "type": "boolean"
        },
        "connectionState": {
          "enum": [
            "CONNECTED",
            "DISCONNECTED"
          ]
        }
      },
      "additionalProperties": true
    },
    "DeviceControlStatus": {
      "type": "object",
      "required": [
        "supported",
        "capabilities",
        "lastAppliedRevision",
        "desiredState"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ControlCapability"
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "lastPollAt": {
          "$ref": "#/$defs/ControlTimestamp"
        },
        "lastAppliedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "desiredState": {
          "$ref": "#/$defs/DeviceDesiredState"
        }
      },
      "additionalProperties": true
    },
    "DeviceControlPollRequest": {
      "type": "object",
      "required": [
        "controlVersion",
        "agentVersion",
        "capabilities",
        "lastAppliedRevision"
      ],
      "properties": {
        "controlVersion": {
          "const": 1
        },
        "agentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ControlCapability"
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "lastAppliedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "DeviceCommand": {
      "type": "object",
      "required": [
        "commandId",
        "requestId",
        "action",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "commandId": {
          "$ref": "#/$defs/Id"
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        },
        "action": {
          "enum": [
            "REFRESH_INVENTORY",
            "CANCEL_SPOOL"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/ControlTimestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/ControlTimestamp"
        },
        "jobId": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": true,
      "anyOf": [
        {
          "type": "object",
          "required": [
            "jobId"
          ],
          "properties": {
            "action": {
              "const": "CANCEL_SPOOL"
            },
            "jobId": {
              "$ref": "#/$defs/Id"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "REFRESH_INVENTORY"
              ]
            },
            "jobId": false
          }
        }
      ]
    },
    "DeviceControlPollResponse": {
      "type": "object",
      "required": [
        "controlVersion",
        "serverTime",
        "pollIntervalSeconds",
        "desiredState",
        "commands"
      ],
      "properties": {
        "controlVersion": {
          "const": 1
        },
        "serverTime": {
          "$ref": "#/$defs/ControlTimestamp"
        },
        "pollIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "desiredState": {
          "$ref": "#/$defs/DeviceDesiredState"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeviceCommand"
          },
          "maxItems": 20
        }
      },
      "additionalProperties": true
    },
    "DeviceCommandReceipt": {
      "type": "object",
      "required": [
        "receiptId",
        "outcome",
        "completedAt"
      ],
      "properties": {
        "receiptId": {
          "$ref": "#/$defs/Id"
        },
        "outcome": {
          "enum": [
            "INVENTORY_REFRESHED",
            "CANCEL_REQUESTED",
            "ALREADY_ABSENT",
            "OWNERSHIP_MISMATCH",
            "UNSUPPORTED",
            "FAILED",
            "EXPIRED",
            "OUTCOME_UNKNOWN"
          ]
        },
        "completedAt": {
          "$ref": "#/$defs/ControlTimestamp"
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "AdminDeviceActionRequest": {
      "type": "object",
      "required": [
        "requestId",
        "issuedAt",
        "action"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/Id"
        },
        "issuedAt": {
          "$ref": "#/$defs/ControlTimestamp"
        },
        "action": {
          "enum": [
            "PAUSE_DISPATCH",
            "RESUME_DISPATCH",
            "DISCONNECT",
            "RECONNECT",
            "REVOKE",
            "REFRESH_INVENTORY",
            "CLEAR_QUEUE",
            "CANCEL_SPOOL"
          ]
        },
        "jobId": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "type": "object",
          "required": [
            "jobId"
          ],
          "properties": {
            "action": {
              "const": "CANCEL_SPOOL"
            },
            "jobId": {
              "$ref": "#/$defs/Id"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "PAUSE_DISPATCH",
                "RESUME_DISPATCH",
                "DISCONNECT",
                "RECONNECT",
                "REVOKE",
                "REFRESH_INVENTORY",
                "CLEAR_QUEUE"
              ]
            },
            "jobId": false
          }
        }
      ]
    },
    "DeviceActionRecord": {
      "type": "object",
      "required": [
        "commandId",
        "requestId",
        "issuedAt",
        "deviceId",
        "action",
        "status",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "commandId": {
          "$ref": "#/$defs/Id"
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        },
        "issuedAt": {
          "$ref": "#/$defs/ControlTimestamp"
        },
        "deviceId": {
          "$ref": "#/$defs/Id"
        },
        "action": {
          "enum": [
            "PAUSE_DISPATCH",
            "RESUME_DISPATCH",
            "DISCONNECT",
            "RECONNECT",
            "REVOKE",
            "REFRESH_INVENTORY",
            "CLEAR_QUEUE",
            "CANCEL_SPOOL"
          ]
        },
        "status": {
          "enum": [
            "PENDING",
            "SUCCEEDED",
            "FAILED",
            "EXPIRED",
            "OUTCOME_UNKNOWN"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/ControlTimestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/ControlTimestamp"
        },
        "jobId": {
          "$ref": "#/$defs/Id"
        },
        "resultCode": {
          "enum": [
            "DESIRED_STATE_UPDATED",
            "CREDENTIAL_REVOKED",
            "QUEUED_JOBS_CANCELLED"
          ]
        },
        "cancelledJobCount": {
          "type": "integer",
          "minimum": 0
        },
        "receipt": {
          "$ref": "#/$defs/DeviceCommandReceipt"
        }
      },
      "additionalProperties": true,
      "anyOf": [
        {
          "type": "object",
          "required": [
            "jobId"
          ],
          "properties": {
            "action": {
              "const": "CANCEL_SPOOL"
            },
            "jobId": {
              "$ref": "#/$defs/Id"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "PAUSE_DISPATCH",
                "RESUME_DISPATCH",
                "DISCONNECT",
                "RECONNECT",
                "REVOKE",
                "REFRESH_INVENTORY",
                "CLEAR_QUEUE"
              ]
            },
            "jobId": false
          }
        }
      ]
    },
    "DeviceActionList": {
      "type": "object",
      "required": [
        "commands",
        "nextCursor"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeviceActionRecord"
          },
          "maxItems": 200
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
