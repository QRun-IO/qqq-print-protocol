          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 30000
        },
        "downloadConnectTimeoutMillis": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 30000
        },
        "downloadIdleTimeoutMillis": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000,
          "default": 30000
        },
        "downloadTimeoutMillis": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000,
          "default": 600000
        },
        "webSocketHandshakeTimeoutMillis": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 30000
        },
        "heartbeatIntervalSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300,
          "default": 20
        },
        "heartbeatTimeoutSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 900,
          "default": 60
        },
        "reconnectMinDelayMillis": {
