          "minimum": 100,
          "maximum": 60000,
          "default": 1000
        },
        "reconnectMaxDelayMillis": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 30000
        },
        "reconnectJitterPercent": {
          "type": "integer",
